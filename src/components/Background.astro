---
// Optional animated background plus the visitor-facing editor. Off by default; the footer
// caption turns it on. The animation code itself loads only once it's switched on.
---

<canvas data-bg-canvas aria-hidden="true" hidden class="pointer-events-none fixed inset-0 -z-10 size-full"></canvas>

<div
  data-bg-editor
  role="dialog"
  aria-labelledby="bg-editor-title"
  hidden
  class="fixed right-3 bottom-3 z-50 w-76 max-w-[calc(100vw-1.5rem)] border border-rule bg-paper font-sans text-[0.8rem] text-ink-2"
>
  <div class="flex items-center justify-between border-b border-rule px-4 py-3">
    <h2 id="bg-editor-title" class="label">Background editor</h2>
    <button
      type="button"
      data-bg-close
      class="-mr-1 grid size-6 cursor-pointer place-items-center text-muted transition-colors hover:text-accent"
      aria-label="Close background editor"
    >
      ✕
    </button>
  </div>

  <div class="max-h-[70vh] space-y-4 overflow-y-auto px-4 py-4">
    <label class="block">
      <span class="label">Plate</span>
      <select data-control="sketch" class="bg-select"></select>
    </label>
    <p data-description class="caption"></p>
    <p data-hint data-sketch-only class="caption text-accent"></p>

    <div data-params class="space-y-3"></div>

    <div data-sketch-only class="space-y-4 border-t border-rule pt-4">
      <div data-globals class="space-y-3"></div>

      <div class="grid grid-cols-3 gap-2 border-t border-rule pt-4">
        <button type="button" data-action="pause" class="bg-button">Pause</button>
        <button type="button" data-action="restart" class="bg-button">Restart</button>
        <button type="button" data-action="reset" class="bg-button">Reset</button>
      </div>
    </div>
  </div>
</div>

<style>
  @reference "../styles/global.css";

  .bg-select {
    @apply mt-1 block w-full border border-rule bg-paper px-2 py-1 text-ink;
  }
  .bg-button {
    @apply cursor-pointer border border-rule px-2 py-1.5 text-ink-2 transition-colors hover:border-accent hover:text-accent;
  }
</style>

<script>
  import { load } from "../lib/backgrounds/settings";
  import type { Controller } from "../lib/backgrounds/controller";

  let controller: Promise<Controller> | undefined;
  const getController = () =>
    (controller ??= import("../lib/backgrounds/controller").then((m) => m.start()));

  if (load().sketch !== "none") getController();

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-bg-action]")) {
    const action = button.dataset.bgAction as keyof Controller;
    button.addEventListener("click", async () => (await getController())[action]());
  }
</script>
