---
import PageLayout from "../../layouts/PageLayout.astro";
import { interests } from "../../site.config";

const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];
---

<PageLayout title="Interests" label="Interests" heading="[Placeholder heading for the interests index]">
  <ol class="mt-12 max-w-3xl divide-y divide-rule border-y border-rule">
    {
      interests.map((interest, i) => (
        <li class="grid gap-1 py-5 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
          <p class="caption pt-[0.35rem]">Ch. {ROMAN[i] ?? i + 1}</p>
          <div>
            <h2 class="font-serif text-[1.2rem] leading-snug">
              <a href={`/interests/${interest.slug}`} class="text-ink transition-colors hover:text-accent">
                {interest.label}
              </a>
            </h2>
            <p class="mt-1 text-[1rem] text-ink-2">{interest.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</PageLayout>
